# 复制为 .env 后填写。不要提交 .env。

# auto：有 DeepSeek 密钥就用；off：只用关键词脚本
SELF_ENGLISH_AI_PROVIDER=auto
SELF_ENGLISH_DEEPSEEK_API_KEY=
SELF_ENGLISH_DEEPSEEK_MODEL=deepseek-chat
SELF_ENGLISH_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 实时语音：接好提供方后再填。现在不会发送录音。
SELF_ENGLISH_VOICE_PROVIDER=
SELF_ENGLISH_VOICE_API_KEY=
